    "Integration": {
      "title": "Teacher Integration",
      "description": "Connected or custom external teaching application metadata owned by the teacher. Never stores secrets, passwords, API keys, or OAuth tokens.",
      "type": "object",
      "properties": {
        "teacherId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isCustom": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "category": {
          "type": "string",
          "enum": [
            "video_conferencing",
            "lms",
            "ai_tools",
            "documents_storage",
            "math_whiteboards",
            "coding_tools",
            "design_creativity",
            "communication",
            "assessment_quizzes",
            "file_sharing",
            "productivity_scheduling",
            "other"
          ]
        },
        "iconKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "accentColor": {
          "type": "string",
          "enum": ["blue", "indigo", "violet", "teal", "emerald", "orange", "amber", "rose", "slate"]
        },
        "websiteUrl": {
          "type": "string",
          "maxLength": 500
        },
        "loginUrl": {
          "type": "string",
          "maxLength": 500
        },
        "apiDocsUrl": {
          "type": "string",
          "maxLength": 500
        },
        "integrationMethod": {
          "type": "string",
          "enum": ["direct_link", "oauth", "api", "webhook", "custom"]
        },
        "supportedMethods": {
          "type": "array",
          "description": "Supported connection methods for this application (1 to 5 entries)."
        },
        "status": {
          "type": "string",
          "enum": ["connected", "disconnected", "configuration_required"]
        },
        "usageNotes": {
          "type": "string",
          "maxLength": 1500
        },
        "permissionsSummary": {
          "type": "string",
          "maxLength": 500
        },
        "connectedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "lastSyncedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "pinnedToQuickLaunch": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "teacherId",
        "catalogId",
        "isCustom",
        "name",
        "category",
        "iconKey",
        "accentColor",
        "integrationMethod",
        "supportedMethods",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/TeacherProfile" },
      "description": "Private teacher profile document keyed by Firebase Auth UID."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students managed by the teacher."
    },
    "/lessonPlans/{planId}": {
      "schema": { "$ref": "#/entities/LessonPlan" },
      "description": "Lesson plans created by the teacher for specific students."
    },
    "/classReports/{reportId}": {
      "schema": { "$ref": "#/entities/ClassReport" },
      "description": "Live class sessions and completed class reports."
    },
    "/aiReports/{aiReportId}": {
      "schema": { "$ref": "#/entities/ApprovedAiReport" },
      "description": "Teacher-approved AI-generated class reports linked to class documentation and student profiles."
    },
    "/homework/{homeworkId}": {
      "schema": { "$ref": "#/entities/Homework" },
      "description": "Homework assignments and review status for students."
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/Resource" },
      "description": "Learning resources attached to student profiles."
    },
    "/monthlyReports/{monthlyReportId}": {
